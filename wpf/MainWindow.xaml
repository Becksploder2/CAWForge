<Window x:Class="CAWForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CAWForge Studio — WPF Migration Preview" Width="1160" Height="860" MinWidth="860" MinHeight="650" Background="#151922" Foreground="#F4F4F4"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="CAWFORGE STUDIO   |   WPF MIGRATION" FontSize="23" FontWeight="Bold" Margin="0,0,0,18"/><TabControl Grid.Row="1" Background="#252B36" Foreground="Black"><TabItem Header="Morph Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Reference Photo" FontSize="18" FontWeight="Bold" Foreground="White"/><Button Content="Choose reference photo" Width="220" HorizontalAlignment="Left" Margin="0,12" Click="ImportPhoto_Click"/><TextBlock x:Name="PhotoPathText" Text="No photo selected" Foreground="White" TextWrapping="Wrap"/><Image x:Name="PhotoPreview" Width="230" Height="210" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,12"/><TextBlock Text="Face template" Foreground="White"/><StackPanel Orientation="Horizontal" Margin="0,8,0,14"><ComboBox x:Name="GenderBox" Width="130" SelectedIndex="1"><ComboBoxItem Content="Male"/><ComboBoxItem Content="Female"/></ComboBox><ComboBox x:Name="TemplateBox" Width="180" Margin="12,0,0,0"/></StackPanel><Button Content="Export morph sheet" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" Click="ExportMorph_Click"/><TextBlock Text="Morph sliders (exportable settings; game import not implemented)" Foreground="White" Margin="0,0,0,8"/><ItemsControl x:Name="SlidersList"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Face Texture"><StackPanel Margin="20"><TextBlock Text="Face Texture — 820 × 820" FontSize="20" Foreground="White" FontWeight="Bold"/><TextBlock Text="Creates a centered, feathered reference-photo crop. Not a game-ready UV texture or AI face reconstruction." Foreground="White" TextWrapping="Wrap" Margin="0,12"/><Button Content="Generate reference crop PNG" Click="GenerateTexture_Click" Width="250" HorizontalAlignment="Left" Margin="0,12"/><Image x:Name="TexturePreview" Width="330" Height="330" Stretch="Uniform" HorizontalAlignment="Left"/></StackPanel></TabItem><TabItem Header="Attire Seam Connect"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="AUTO-SEAM CONNECT" FontSize="20" FontWeight="Bold" Foreground="White"/><TextBlock Text="Create horizontally tileable patterns for top or bottoms textures. Actual WWE 2K26 garment UV alignment requires garment-specific maps." Foreground="White" TextWrapping="Wrap" Margin="0,10,0,12"/><Button Content="Choose attire pattern image" Width="250" HorizontalAlignment="Left" Click="ImportAttire_Click"/><TextBlock x:Name="AttireFileText" Text="No attire image selected" Foreground="White" Margin="0,8"/><CheckBox x:Name="TopSeamCheck" Content="Generate top texture" IsChecked="True" Foreground="White" Margin="0,6"/><CheckBox x:Name="BottomSeamCheck" Content="Generate bottoms texture" IsChecked="True" Foreground="White" Margin="0,6"/><TextBlock Text="Seam mode" Foreground="White" Margin="0,12,0,5"/><ComboBox x:Name="SeamModeBox" Width="240" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="Continuous wrap"/><ComboBoxItem Content="Mirrored edges"/><ComboBoxItem Content="Blended edges"/></ComboBox><TextBlock Text="Blend width (pixels)" Foreground="White" Margin="0,12,0,4"/><Slider x:Name="SeamBlendSlider" Minimum="0" Maximum="64" Value="16" TickFrequency="2" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left"/><Button x:Name="GenerateSeamsButton" Content="Generate Seamless PNG Textures" Width="300" HorizontalAlignment="Left" Margin="0,15,0,12" Click="GenerateSeams_Click"/><Image x:Name="AttirePreview" Width="360" Height="300" HorizontalAlignment="Left" Stretch="Uniform"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Graphic Generator"><StackPanel Margin="20"><TextBlock Text="Procedural graphic features are still being migrated." Foreground="White"/></StackPanel></TabItem></TabControl><TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" Text="Ready — WPF prototype; legacy Win32 build remains unchanged." Foreground="#A9D6B2"/></Grid></Window>