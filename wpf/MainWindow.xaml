<Window x:Class="CAWForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CAWForge Studio — WPF Migration Preview" Width="1160" Height="860" MinWidth="860" MinHeight="650" Background="#151922" Foreground="#F4F4F4"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="CAWFORGE STUDIO   |   WPF MIGRATION" FontSize="23" FontWeight="Bold" Margin="0,0,0,18"/><TabControl Grid.Row="1" Background="#252B36" Foreground="Black"><TabItem Header="Morph Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Reference Photo" FontSize="18" FontWeight="Bold" Foreground="White"/><Button Content="Choose reference photo" Width="220" HorizontalAlignment="Left" Margin="0,12" Click="ImportPhoto_Click"/><TextBlock x:Name="PhotoPathText" Text="No photo selected" Foreground="White" TextWrapping="Wrap"/><Image x:Name="PhotoPreview" Width="230" Height="210" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,12"/><TextBlock Text="Face template" Foreground="White"/><Button x:Name="MatchTemplateButton" Content="Find closest installed template" Width="260" HorizontalAlignment="Left" Margin="0,8" Click="MatchTemplate_Click"/><TextBlock x:Name="MatchStatusText" Text="Requires template reference images in the Templates folder; visual comparison only." TextWrapping="Wrap" Foreground="White" Margin="0,4,0,8"/><StackPanel Orientation="Horizontal" Margin="0,8,0,14"><ComboBox x:Name="GenderBox" Width="130" SelectedIndex="1"><ComboBoxItem Content="Male"/><ComboBoxItem Content="Female"/></ComboBox><ComboBox x:Name="TemplateBox" Width="180" Margin="12,0,0,0"/></StackPanel><Button Content="Export morph sheet" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" Click="ExportMorph_Click"/><TextBlock Text="Morph sliders (exportable settings; game import not implemented)" Foreground="White" Margin="0,0,0,8"/><TextBlock Text="Morph categories" Foreground="White" FontWeight="Bold" Margin="0,4,0,8"/><WrapPanel x:Name="MorphCategoryButtons" Margin="0,0,0,12"/><TextBlock x:Name="ActiveMorphCategory" Text="Head" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><ItemsControl x:Name="SlidersList"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Face Texture"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12"><TextBlock Text="Face Texture — 820 × 820" FontSize="20" Foreground="White" FontWeight="Bold"/><TextBlock Text="Detects a frontal face and generates an 820 × 820 skin-backed texture. Hair removal and exact WWE 2K26 UV alignment are still experimental." Foreground="White" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Local AI enhancement (Real-ESRGAN Vulkan; NVIDIA GPU)" Foreground="White" Margin="0,8,0,4"/><ComboBox x:Name="FaceUpscaleBox" Width="280" HorizontalAlignment="Left" SelectedIndex="1"><ComboBoxItem Content="Off — original image"/><ComboBoxItem Content="2× AI upscale — recommended"/><ComboBoxItem Content="4× AI upscale — maximum detail"/></ComboBox><TextBlock x:Name="MorphTextureTemplateText" Text="Morph Settings face template" Foreground="White" Margin="0,10,0,3"/><Button Content="Copy Ultra-Realistic Master Prompt (uses Morph Settings template)" Click="CopyTexturePrompt_Click" MinWidth="220" MaxWidth="480" HorizontalAlignment="Left" Margin="0,4,0,8"/><TextBlock Text="Prompt is a specification for an AI image generator; the local OpenCV fusion tool below does not execute prompts." Foreground="#FFBDBDBD" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Face Scan Fusion — choose a template from your library" Foreground="White" Margin="0,10,0,4"/><TextBlock Text="Template library (female / male)" Foreground="White"/><ComboBox x:Name="FusionLibraryBox" Width="310" HorizontalAlignment="Left" SelectionChanged="FusionLibraryBox_SelectionChanged"/><Button Content="Install template pack (ZIP)" Click="LoadFusionLibrary_Click" Width="250" HorizontalAlignment="Left" Margin="0,6,0,6"/><Image x:Name="FusionTemplatePreview" Width="180" Height="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,6,0,4"/><TextBlock x:Name="FusionTemplateText" Text="Choose a female or male face template" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,8"/><Button Content="Generate face texture PNG" Click="GenerateTexture_Click" Width="250" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Generated texture preview" Foreground="White" FontWeight="Bold" Margin="0,10,0,6"/><Border BorderBrush="#FF777777" BorderThickness="1" Background="#FF292929" Padding="5" HorizontalAlignment="Stretch" MinHeight="300"><Image x:Name="TexturePreview" MinWidth="240" MinHeight="300" MaxHeight="650" Stretch="Uniform" HorizontalAlignment="Stretch"/></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="Attire Seam Connect"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="FOUR-PANEL ATTIRE SEAM CONNECTOR" FontSize="20" FontWeight="Bold" Foreground="White"/><TextBlock Text="Import front, back, left and right PNGs. Each side panel is adjusted to join BOTH the front and back edges. Export four connected images." Foreground="White" TextWrapping="Wrap" Margin="0,10,0,12"/><Button Content="Choose FRONT texture" Width="250" HorizontalAlignment="Left" Click="ImportFront_Click"/><TextBlock x:Name="FrontFileText" Text="No front texture" Foreground="White" Margin="0,4,0,8"/><Button Content="Choose BACK texture" Width="250" HorizontalAlignment="Left" Click="ImportBack_Click"/><TextBlock x:Name="BackFileText" Text="No back texture" Foreground="White" Margin="0,4,0,8"/><Button Content="Choose LEFT SIDE texture" Width="250" HorizontalAlignment="Left" Click="ImportLeft_Click"/><TextBlock x:Name="LeftFileText" Text="No left side texture" Foreground="White" Margin="0,4,0,8"/><Button Content="Choose RIGHT SIDE texture" Width="250" HorizontalAlignment="Left" Click="ImportRight_Click"/><TextBlock x:Name="RightFileText" Text="No right side texture" Foreground="White" Margin="0,4,0,8"/><TextBlock Text="Seam blend width (pixels)" Foreground="White" Margin="0,12,0,4"/><Slider x:Name="SeamBlendSlider" Minimum="4" Maximum="128" Value="32" TickFrequency="4" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left"/><Button x:Name="GenerateSeamsButton" Content="Connect all four panels and export" Width="310" HorizontalAlignment="Left" Margin="0,15,0,12" Click="GenerateSeams_Click"/><TextBlock Text="Joined layout preview: BACK | LEFT | FRONT | RIGHT | BACK" Foreground="White" Margin="0,8"/><Image x:Name="AttirePreview" Width="650" Height="260" HorizontalAlignment="Left" Stretch="Uniform"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Render Creator"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="CAW RENDER CREATOR" FontSize="20" FontWeight="Bold" Foreground="White"/><TextBlock Text="Import an in-game CAW screenshot. Create a studio-style transparent PNG with automatic subject isolation, color grading and lighting. Generative AI likeness reconstruction requires a separate local image model." Foreground="White" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="Import CAW screenshot" Click="ImportRender_Click" Width="220" HorizontalAlignment="Left"/><TextBlock x:Name="RenderFileText" Text="No screenshot selected" Foreground="White" Margin="0,5,0,12"/><TextBlock Text="Background removal threshold" Foreground="White"/><Slider x:Name="RenderThreshold" Minimum="12" Maximum="100" Value="40" Width="280" HorizontalAlignment="Left"/><Button Content="Create studio render PNG" Click="GenerateRender_Click" Width="250" HorizontalAlignment="Left" Margin="0,12"/><Image x:Name="RenderPreview" Width="440" Height="440" Stretch="Uniform" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Graphic Generator"><StackPanel Margin="20"><TextBlock Text="Procedural graphic features are still being migrated." Foreground="White"/></StackPanel></TabItem></TabControl><TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" Text="Ready — WPF prototype; legacy Win32 build remains unchanged." Foreground="#A9D6B2"/></Grid></Window>